{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.length >= 16 && $room.length <= 32 && $room.matches(/^[A-Z0-9]+$/)",
        ".write": "$room.length >= 16 && $room.length <= 32 && $room.matches(/^[A-Z0-9]+$/)",
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        },
        "players": {
          "$pid": {
            ".validate": "newData.hasChildren(['name', 'color', 'createdAt'])"
          }
        },
        "games": {
          "$gid": {
            ".validate": "newData.hasChildren(['title', 'order', 'createdAt'])"
          }
        },
        "voting": {
          "suggestions": {
            "$sid": {
              ".validate": "newData.hasChildren(['title', 'createdAt'])"
            }
          }
        }
      }
    }
  }
}
